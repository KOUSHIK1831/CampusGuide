# Copy to .env. Do not commit the real key.
GROQ_API_KEY=replace_with_your_key
LLM_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_BACKEND=faiss
VECTOR_STORE_PATH=data/processed
DATA_RAW_PATH=data/raw
MIN_RETRIEVAL_SCORE=0.30
# Optional: use only fictional examples when running a public demo.
# DATA_RAW_PATH=data/examples
# AUTO_INGEST_ON_START=true
# ALLOW_UPLOADS=false
# MAX_DEMO_QUERIES=10

# Optional local configuration for CLI tools and model selection.
# Interactive Streamlit users enter their own Groq key in the sidebar (BYOK).
# Do not configure a shared GROQ_API_KEY for a public hosted UI.
LLM_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_BACKEND=faiss
MIN_RETRIEVAL_SCORE=0.30

# Only the optional CLI ingestion/evaluation scripts read these disk locations.
DATA_RAW_PATH=data/raw
VECTOR_STORE_PATH=data/processed

# Local CLI only: set GROQ_API_KEY in your private .env if using CLI LLM calls.
# GROQ_API_KEY=replace_with_your_key
